{
    "name": "gw2-items",
    "private": true,
    "version": "0.1.0",
    "description": "Searches Guild Wars 2 items and shows which ones might be usable in Fractals of the Mist.",
    "type": "module",
    "workspaces": [
        "server",
        "web"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "concurrently --names server,web --prefix-colors blue,green --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "npm run dev --workspace server",
        "dev:web": "npm run dev --workspace web",
        "build": "npm run build --workspace web && npm run build --workspace server",
        "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
        "start": "npm run start --workspace server",
        "db:import": "npm run db:import --workspace server --",
        "test": "npm run test --workspace server",
        "export:static": "npm run export:static --workspace server --",
        "build:pages": "node scripts/pages.mjs build",
        "preview:pages": "node scripts/pages.mjs preview",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "concurrently": "^10.0.6",
        "prettier": "3.9.10"
    }
}
